# --- Datasets -------------------------------------------------------------
# El export de Roboflow pesa 202 MB y se descarga de su fuente original
# (ver "Créditos de los datos" en el README). No tiene sentido versionarlo.
Clasificacion de Basura.v4i.folder/
*.v4i.folder/

# data/processed son enlaces duros al dataset original y data/external se
# regenera con ml/fetch_hazardous.py. Ambos se reconstruyen en un comando.
data/processed/
data/external/

# Ningun zip entra al repo. En particular data.zip, que es un empaquetado del
# directorio data/ y pesa 180 MB: por encima del limite de 100 MB por archivo
# de GitHub, y ademas contenido derivado que se regenera.
*.zip

# --- Modelos --------------------------------------------------------------
# Cada checkpoint ronda los 80 MB. Se regeneran con ml/train.py y
# ml/export_model.py; las métricas y gráficas sí se versionan porque son
# pequeñas y documentan los resultados.
artifacts/*.pt
artifacts/*.onnx
artifacts/*.onnx.data

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- App móvil ------------------------------------------------------------
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/web-build/
*.jks
*.keystore

# --- Entorno y editores ---------------------------------------------------
.env
.env.*
!.env.example
*.log
.vscode/
.idea/
.DS_Store
Thumbs.db
